# Environment Configuration Example
# Copia este archivo a .env y completa con tus valores reales

# ============ DESARROLLO ============
MY_DEBUG=True
MY_SECRET_KEY=tu-secret-key-super-segura-aqui

# ============ PRODUCCION ============
# Descomentar y configurar para producción
# MY_DEBUG=False
# MY_SECRET_KEY=tu-secret-key-super-segura-aqui
# ALLOWED_HOSTS=tudominio.com,www.tudominio.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ============ OAUTH GOOGLE ============
# Obtener valores de https://console.cloud.google.com
# GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_SECRET=tu-secret-key
